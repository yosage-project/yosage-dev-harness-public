            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/knowledge-index.sh"
            ]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/commit-trailer-notice.sh"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
